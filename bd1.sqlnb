cells:
  - kind: 2
    value: "drop table holdings;\r

      drop table transactions;\r

      drop table assets;\r

      drop table wallets;\r

      drop table users;"
    languageId: oracle-sql
  - kind: 1
    value: creation de la table Users(Utilisateur)
    languageId: markdown
  - kind: 2
    value: "create table users(\r

      \    user_id INTEGER PRIMARY KEY not null,\r

      \    email varchar(255) not null,\r

      \    password_hash varchar(255) not null,\r

      \    first_name varchar(255),\r

      \    last_name varchar(255),\r

      \    kyc_status varchar(255) default 'Pending',\r

      \    is_accredited number DEFAULT 0,\r

      \    created_at DATE ,\r

      \    constraint ck_kyc check(kyc_status in
      ('Approved','Pending','Rejected'))\r

      \r

      );\r\n"
    languageId: oracle-sql
  - kind: 1
    value: creation de la table Wallets(portefeuille electronique)
    languageId: markdown
  - kind: 2
    value: "create table wallets(\r

      \    wallet_id INTEGER PRIMARY KEY not null,\r

      \    user_id INTEGER REFERENCES users(user_id),\r

      \    currency_code VARCHAR(5) DEFAULT 'TND',\r

      \    balance DECIMAL(10,4),\r

      \    status VARCHAR(50) default 'Active' check(status in
      ('Active','Frozen','closed')) ,\r

      \    created_at DATE,\r

      \    unique(wallet_id,user_id)\r

      );\r\n"
    languageId: oracle-sql
  - kind: 1
    value: creation de la table Assets(Actifs)
    languageId: markdown
  - kind: 2
    value: "create table assets(\r

      \    asset_id Integer PRIMARY KEY not null,\r

      \    asset_name VARCHAR(255),\r

      \    asset_type VARCHAR(255) \r

      \    check(asset_type in ('Private
      Equity','Withdrawal','Deposit','Stocks','Bonds')),\r

      \    total_valuation  DECIMAL(19,4),\r

      \    minimum_investment DECIMAL(10,4),\r

      \    current_status VARCHAR(255),\r

      \    description VARCHAR2(2000),\r

      \    created_at DATE \r

      );\r

      \r\n"
    languageId: oracle-sql
  - kind: 1
    value: creation de la table Transactions
    languageId: markdown
  - kind: 2
    value: "create table transactions(\r

      \        transaction_id INTEGER PRIMARY KEY not null,\r

      \        wallet_id INTEGER REFERENCES wallets(wallet_id),\r

      \        transaction_type VARCHAR(255),\r

      \        amount DECIMAL(10,4),\r

      \        running_balance DECIMAL(10,4),\r

      \        status VARCHAR(100) default 'Pending' check(status in
      ('Pending','Completed','Failed','Reversed')),\r

      \        external_reference_id Integer,\r

      \        description VARCHAR2(2000),\r

      \        created_at TIMESTAMP with time zone default CURRENT_TIMESTAMP \r

      );\r

      \r\n"
    languageId: oracle-sql
  - kind: 1
    value: creation de la table Holdings
    languageId: markdown
  - kind: 2
    value: "\r

      create table holdings(\r

      \    holding_id INTEGER,\r

      \    user_id INTEGER REFERENCES users(user_id),\r

      \    asset_id INTEGER REFERENCES assets(asset_id),\r

      \    quantity INTEGER,\r

      \    average_purchase_price DECIMAL(10,4),\r

      \    last_updated_at TIMESTAMP\r

      );"
    languageId: oracle-sql
  - kind: 1
